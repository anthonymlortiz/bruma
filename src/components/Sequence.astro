---
import Plate from './Plate.astro';
import mountainAir from '../assets/photography/mountain-air.jpg';
import valleyRange from '../assets/photography/valley-range.jpg';
import rollingHills from '../assets/photography/rolling-hills.jpg';

const notes = {
  air: 'Mountain air',
  unhurried: 'Unhurried living',
  rooted: 'Rooted in Jarabacoa',
};
---

<section class="sequence" aria-label="Jarabacoa">
  <div class="sequence__grid">
    <Plate
      class="seq-a"
      src={mountainAir}
      alt="Morning mist lying in the valleys below Jarabacoa, seen through the canopy of a tree"
      ratio="var(--r)"
      position="50% 50%"
      sizes="(min-width: 64em) 56vw, 100vw"
      widths={[420, 640, 800, 1100, 1400, 1600]}
      parallax
    />
    <p class="note note--a" data-reveal>
      <span class="note__tick" aria-hidden="true"></span>
      <span class="note__text display">{notes.air}</span>
    </p>

    <Plate
      class="seq-b"
      src={valleyRange}
      alt="The Jarabacoa valley opening toward a hazy line of mountains"
      ratio="var(--r)"
      position="50% 50%"
      sizes="(min-width: 64em) 60vw, 100vw"
      widths={[640, 900, 1200, 1600, 2000, 2600]}
      parallax
    />
    <p class="note note--b" data-reveal>
      <span class="note__tick" aria-hidden="true"></span>
      <span class="note__text display">{notes.unhurried}</span>
    </p>
  </div>

  <Plate
    class="seq-c"
    src={rollingHills}
    alt="Rolling green hills folding into one another under high afternoon cloud"
    ratio="var(--r)"
    position="50% 50%"
    sizes="100vw"
    widths={[768, 1080, 1440, 1920, 2400, 2800]}
    parallax
  />
  <p class="note note--c" data-reveal>
    <span class="note__tick" aria-hidden="true"></span>
    <span class="note__text display">{notes.rooted}</span>
  </p>
</section>

<style>
  .sequence {
    padding-block: var(--section-y);
  }

  .sequence__grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: clamp(2.75rem, 7vh, 4.5rem);
    padding-inline: var(--gutter);
  }

  .note {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2vh, 1.4rem);
  }

  .note__tick {
    display: block;
    width: clamp(2rem, 5vw, 3.75rem);
    height: 1px;
    background: rgba(243, 237, 225, 0.28);
  }

  .note__text {
    font-size: clamp(1.45rem, 0.95rem + 2vw, 2.5rem);
    font-style: italic;
    line-height: 1.2;
    color: var(--ink-muted);
  }

  /* Frame ratios per plate. Sources are pre-cropped in the asset pipeline, so
     these stay close to the asset ratio and only tighten on small screens. */
  .seq-a {
    --r: 4 / 5;
  }

  .seq-b {
    --r: 16 / 11;
  }

  .seq-c {
    --r: 16 / 10;
    margin-top: clamp(3rem, 9vh, 5.5rem);
  }

  .note--c {
    align-items: center;
    text-align: center;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    padding-inline: var(--gutter);
  }

  .note--c .note__tick {
    width: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* Editorial zig-zag once there is room for it. */
  @media (min-width: 64em) {
    .sequence__grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      row-gap: clamp(6rem, 14vh, 10rem);
    }

    .seq-a {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .note--a {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: end;
      padding-bottom: clamp(1.5rem, 5vh, 3.5rem);
    }

    .seq-b {
      grid-column: 6 / -1;
      grid-row: 2;
    }

    .note--b {
      grid-column: 1 / span 4;
      grid-row: 2;
      align-self: center;
    }

    .seq-c {
      --r: 2.6 / 1;
      margin-top: clamp(6rem, 14vh, 10rem);
    }
  }

  @media (min-width: 48em) {
    .seq-b {
      --r: 2 / 1;
    }
  }

  @media (min-width: 48em) and (max-width: 63.999em) {
    .seq-c {
      --r: 2.2 / 1;
    }
  }
</style>
