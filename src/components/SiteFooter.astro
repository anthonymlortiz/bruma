---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bruma-mark-ivory.png';
import { site } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <Image
        class="footer__mark"
        src={mark}
        alt=""
        aria-hidden="true"
        widths={[160, 240, 320]}
        sizes="7.5rem"
        format="webp"
        quality={90}
        loading="lazy"
      />
      <p class="footer__name">{site.name}</p>
      <p class="footer__place">{site.place.locality}, {site.place.country}</p>
    </div>

    <div class="footer__meta">
      <a class="footer__link" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
        <span class="visually-hidden">Instagram</span>
        {site.instagram.handle}
      </a>
      <p class="footer__copy">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    background-color: var(--night);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(2.5rem, 7vh, 4rem);
    padding: clamp(3.5rem, 9vh, 5.5rem) var(--gutter);
  }

  .footer__mark {
    width: 7.5rem;
    height: auto;
    opacity: 0.62;
    margin-bottom: 1.5rem;
  }

  .footer__name {
    font-size: clamp(0.72rem, 0.68rem + 0.16vw, 0.8rem);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    line-height: 1.6;
    color: var(--ivory);
  }

  .footer__place {
    margin-top: 0.55rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-quiet);
  }

  .footer__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .footer__link {
    font-size: 0.92rem;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.15rem;
    transition:
      color 450ms var(--ease),
      border-color 450ms var(--ease);
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--ivory);
    border-bottom-color: var(--hairline);
  }

  .footer__copy {
    font-size: 0.82rem;
    color: var(--ink-quiet);
  }

  @media (min-width: 48em) {
    .footer__meta {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
