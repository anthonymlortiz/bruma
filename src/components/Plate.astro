---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props extends astroHTML.JSX.HTMLAttributes {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  /** CSS aspect-ratio for the frame; the photograph is cropped to fit. */
  ratio?: string;
  /** object-position, to protect the composition when cropping. */
  position?: string;
  parallax?: boolean;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [640, 900, 1200, 1600, 2000],
  ratio = '3 / 2',
  position = '50% 50%',
  parallax = false,
  eager = false,
  class: className,
  ...rest
} = Astro.props;
---

<figure class:list={['plate', className]} {...rest}>
  <div
    class="plate__frame"
    style={`--ratio:${ratio};--pos:${position}`}
    data-parallax={parallax ? '' : undefined}
  >
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>
</figure>

<style>
  .plate {
    position: relative;
  }

  .plate__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background-color: var(--forest);
  }

  .plate__frame :global(picture) {
    display: contents;
  }

  .plate__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  /* A little extra height gives the parallax somewhere to travel. */
  .plate__frame[data-parallax] :global(img) {
    height: 118%;
    top: -9%;
    transform: translate3d(0, calc(var(--py, 0) * 1%), 0);
  }

  /* A quiet forest wash keeps the photography inside the brand's key. */
  .plate__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(7, 12, 9, 0.34) 0%, rgba(7, 12, 9, 0.08) 42%, rgba(7, 12, 9, 0.42) 100%),
      linear-gradient(0deg, rgba(18, 32, 25, 0.22), rgba(18, 32, 25, 0.22));
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .plate__frame[data-parallax] :global(img) {
      height: 100%;
      top: 0;
      transform: none;
    }
  }
</style>
