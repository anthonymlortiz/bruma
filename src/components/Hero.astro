---
import { Picture, Image } from 'astro:assets';
import lockup from '../assets/brand/bruma-lockup-ivory.png';
import heroImage from '../assets/photography/hero-ridges.jpg';
import { copy, site, type Lang } from '../content/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section class="hero" id="top">
  <div class="hero__media" data-parallax>
    <Picture
      src={heroImage}
      alt={t.hero.imageAlt}
      widths={[768, 1080, 1440, 1920, 2560, 3200]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={70}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 class="hero__title">
      <Image
        class="hero__lockup"
        src={lockup}
        alt={site.name}
        widths={[280, 400, 560, 800]}
        sizes="(min-width: 64em) 25rem, (min-width: 40em) 32vw, 62vw"
        format="webp"
        quality={92}
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero__hairline" aria-hidden="true"></span>
      <span class="hero__statement display">{t.hero.statement}</span>
    </h1>
    <p class="hero__tagline">{t.hero.tagline}</p>
  </div>

  <a class="hero__cue" href="#intro">
    <span class="eyebrow">{t.hero.cue}</span>
    <span class="hero__cue-track" aria-hidden="true"><span class="hero__cue-pulse"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(6rem, 14vh, 9rem) var(--gutter) clamp(7rem, 15vh, 9rem);
    overflow: clip;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    animation: hero-settle 2600ms var(--ease) both;
  }

  .hero__media :global(picture) {
    display: contents;
  }

  .hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 116%;
    top: -8%;
    object-fit: cover;
    object-position: 50% 58%;
    transform: translate3d(0, calc(var(--py, 0) * 1%), 0);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgba(7, 12, 9, 0.62) 0%,
        rgba(7, 12, 9, 0.34) 26%,
        rgba(7, 12, 9, 0.44) 58%,
        rgba(7, 12, 9, 0.88) 88%,
        var(--night) 100%
      ),
      radial-gradient(115% 78% at 50% 46%, rgba(7, 12, 9, 0) 24%, rgba(7, 12, 9, 0.62) 100%),
      linear-gradient(0deg, rgba(18, 32, 25, 0.3), rgba(18, 32, 25, 0.3));
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 46rem;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font-weight: 300;
  }

  .hero__lockup {
    width: clamp(13rem, 32vw, 25rem);
    height: auto;
    filter: drop-shadow(0 0.6rem 2.2rem rgba(7, 12, 9, 0.55));
    animation: lockup-in 1500ms var(--ease) 260ms both;
  }

  .hero__hairline {
    display: block;
    width: clamp(2.5rem, 6vw, 4rem);
    height: 1px;
    margin-block: clamp(1.9rem, 4.4vh, 3rem) clamp(1.6rem, 3.6vh, 2.4rem);
    background: rgba(243, 237, 225, 0.34);
    animation: fade-up 1400ms var(--ease) 620ms both;
  }

  .hero__statement {
    display: block;
    font-size: clamp(1.7rem, 1.05rem + 3vw, 3rem);
    color: var(--ivory);
    animation: fade-up 1500ms var(--ease) 720ms both;
  }

  .hero__tagline {
    margin-top: clamp(1.1rem, 2.4vh, 1.6rem);
    max-width: 38rem;
    font-size: clamp(0.95rem, 0.9rem + 0.24vw, 1.09rem);
    line-height: 1.7;
    color: var(--ink-muted);
    text-wrap: balance;
    animation: fade-up 1500ms var(--ease) 880ms both;
  }

  .hero__cue {
    position: absolute;
    bottom: clamp(1.75rem, 4.5vh, 3rem);
    left: 50%;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--stone);
    animation: fade-up 1600ms var(--ease) 1150ms both;
    transition: color 600ms var(--ease);
  }

  .hero__cue:hover {
    color: var(--ivory);
  }

  .hero__cue .eyebrow {
    font-size: 0.63rem;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    color: currentColor;
  }

  .hero__cue-track {
    position: relative;
    display: block;
    width: 1px;
    height: clamp(3.5rem, 8.5vh, 5rem);
    background: rgba(243, 237, 225, 0.26);
    overflow: hidden;
  }

  .hero__cue-pulse {
    position: absolute;
    inset-inline: 0;
    top: -55%;
    height: 55%;
    background: linear-gradient(180deg, transparent, var(--ivory));
    animation: cue-fall 2900ms cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.07);
      opacity: 0.35;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes lockup-in {
    from {
      opacity: 0;
      transform: translate3d(0, 1rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 0.9rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cue-fall {
    0% {
      top: -55%;
    }

    75%,
    100% {
      top: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media,
    .hero__lockup,
    .hero__hairline,
    .hero__statement,
    .hero__tagline,
    .hero__cue,
    .hero__cue-pulse {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero__media :global(img) {
      height: 100%;
      top: 0;
      transform: none;
    }

    .hero__cue-pulse {
      top: 0;
      height: 100%;
      background: rgba(243, 237, 225, 0.45);
    }
  }
</style>
